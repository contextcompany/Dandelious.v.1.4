{
  "appId": "com.context.vanguard",
  "productName": "Vanguard",
  "copyright": "Copyright © 2026 Context Ecosystem",
  "directories": {
    "output": "dist_desktop"
  },
  "files": [
    "dist/**/*",
    "electron-main.js",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Vanguard AI"
  }
}
